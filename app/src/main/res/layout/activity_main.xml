<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0B0F">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="i mobile" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your mobile service" android:textColor="#A7A9B4" android:textSize="16sp"/>
<TextView android:id="@+id/simInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="20dp" android:background="#171820" android:text="Checking SIM..." android:textColor="#FFFFFF" android:textSize="17sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="i mobile services" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
<Button android:id="@+id/activateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Activate i mobile SIM"/>
<Button android:id="@+id/airtimeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Buy Airtime"/>
<Button android:id="@+id/dataButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Buy Data Bundle"/>
<Button android:id="@+id/transactionsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Transactions"/>
<Button android:id="@+id/supportButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Customer Support"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Real SIM activation requires an approved i mobile telecom/MVNO connection." android:textColor="#777A86" android:textSize="13sp"/>
</LinearLayout></ScrollView>